      propertyPath: _history.Array.data[12].Name
      value: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
        \u0434\u043E\u043C\u043E\u0439 \u0438\u0437 \u043F\u043E\u0434\u0432\u0430\u043B\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 8877640285328990349, guid: f1a5a15d787c8fb438e01b3cbe0b5181, type: 3}
      propertyPath: _history.Array.data[13].Name
      value: "\u0414\u0438\u0430\u043B\u043E\u0433 \u0411\u0410 + \u0413\u0413 (\u0417\u0430\u0431\u0435\u0440\u0438
